<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPlayer.App">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="TemplatedControl">
            <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Code, Fira Code, Consolas, monospace" />
        </Style>
    </Application.Styles>
</Application>
