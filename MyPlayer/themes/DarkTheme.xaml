<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Color x:Key="BackgroundColor">#161A22</Color>
    <Color x:Key="PanelColor">#1E2531</Color>
    <Color x:Key="InputColor">#222B39</Color>
    <Color x:Key="BorderColorDark">#3A4659</Color>
    <Color x:Key="TextColor">#E7EDF6</Color>
    <Color x:Key="MutedTextColor">#AAB6C7</Color>
    <Color x:Key="AccentColor">#008080</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource InputColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColorDark}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

    <LinearGradientBrush x:Key="TitleBarGradient" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#008080" Offset="0.0"/>
        <GradientStop Color="#161A22" Offset="1.0"/>
    </LinearGradientBrush>
</ResourceDictionary>
