<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#F3F3F3</Color>
    <Color x:Key="PanelColor">#FFFFFF</Color>
    <Color x:Key="InputColor">#FFFFFF</Color>
    <Color x:Key="BorderColorDark">#CCCCCC</Color>
    <Color x:Key="TextColor">#333333</Color>
    <Color x:Key="MutedTextColor">#666666</Color>
    <Color x:Key="AccentColor">#0ea5e9</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource InputColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColorDark}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

    <LinearGradientBrush x:Key="TitleBarGradient" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#0ea5e9" Offset="0.0"/>
        <GradientStop Color="#F3F3F3" Offset="1.0"/>
    </LinearGradientBrush>
</ResourceDictionary>
