<Window x:Class="MyPlayer.views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewmodels="clr-namespace:MyPlayer.viewmodels"
        mc:Ignorable="d"
        Title="My Player" 
        Width="{Binding WindowWidth, Mode=TwoWay}" 
        Height="{Binding WindowHeight, Mode=TwoWay}"
        Left="{Binding WindowLeft, Mode=TwoWay}"
        Top="{Binding WindowTop, Mode=TwoWay}"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="35" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="5"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
        <Grid Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Path Bar -->
                <RowDefinition Height="*"/> <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Player Controls -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarGradient}">
                <TextBlock Text="My Player" VerticalAlignment="Center" Margin="15,0" FontWeight="Bold" Foreground="White"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="–" Width="40" Height="35" Background="Transparent" BorderThickness="0" Foreground="White" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnMinimize_Click"/>
                    <Button Content="✕" Width="40" Height="35" Background="Transparent" BorderThickness="0" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E74C3C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Path Bar -->
            <DockPanel Grid.Row="1" LastChildFill="True" Margin="10,10,10,5">
                <Button Command="{Binding ToggleThemeCommand}" DockPanel.Dock="Right" Width="35" Height="28" Margin="5,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="☀" FontSize="14"/>
                </Button>
                <Button Command="{Binding BrowseCommand}" DockPanel.Dock="Right" Width="35" Height="28" Margin="5,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image Source="/recursos/icones/icons8-folder-20.png" Width="18" Height="18"/>
                </Button>
                <Label Content="Músicas:" VerticalAlignment="Center" FontSize="12"/>
                <TextBox Text="{Binding MusicPath, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" IsReadOnly="True" FontSize="12"/>
            </DockPanel>

            <!-- Main Content -->
            <Grid Grid.Row="2" Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TreeView Folders -->
                <TreeView ItemsSource="{Binding Folders}" BorderThickness="1" Grid.Column="0">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding SubFolders}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/recursos/icones/icons8-folder-20.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Name}" FontSize="12"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- ListView Songs -->
                <DockPanel Grid.Column="2" Margin="5,0,0,0">
                    <TextBox x:Name="txtFilter" DockPanel.Dock="Top" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" Height="26" FontSize="12"/>
                    
                    <ListView ItemsSource="{Binding Playlist}" SelectedItem="{Binding SelectedMusica}" BorderThickness="1" MouseDoubleClick="ListView_MouseDoubleClick">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Abrir Pasta" Command="{Binding OpenFolderCommand}">
                                    <MenuItem.Icon>
                                        <Image Source="/recursos/icones/icons8-folder-20.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copiar Nome do Arquivo" Command="{Binding CopyFileNameCommand}">
                                    <MenuItem.Icon>
                                        <Image Source="/recursos/icones/icons8-save-20.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Remover Música" Command="{Binding RemoveCommand}">
                                    <MenuItem.Icon>
                                        <Image Source="/recursos/icones/icons8-remove-20.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Limpar Playlist" Command="{Binding ClearCommand}">
                                    <MenuItem.Icon>
                                        <Image Source="/recursos/icones/icons8-clear-20.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nome" Width="350">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/recursos/icones/icons8-mp3-26.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding Text}" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Caminho" DisplayMemberBinding="{Binding Tag}" Width="150"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Grid>

            <!-- Player Controls -->
            <Grid Grid.Row="3" Margin="10,5,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- 8 Buttons Group -->
                    <ColumnDefinition Width="*"/>    <!-- Progress/Slider/Status Area -->
                </Grid.ColumnDefinitions>

                <!-- 8 Buttons Group (2 rows of 4) -->
                <UniformGrid Grid.Row="0" Grid.Column="0" Rows="2" Columns="4" VerticalAlignment="Center">
                    <!-- Row 1 -->
                    <Button Command="{Binding ClearCommand}" Width="32" Height="26" Margin="0,0,4,4" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Limpar">
                        <Image Source="/recursos/icones/icons8-clear-20.png" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding RemoveCommand}" Width="32" Height="26" Margin="0,0,4,4" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Remover">
                        <Image Source="/recursos/icones/icons8-remove-20.png" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding SaveCommand}" Width="32" Height="26" Margin="0,0,4,4" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Salvar">
                        <Image Source="/recursos/icones/icons8-save-20.png" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding LoadCommand}" Width="32" Height="26" Margin="0,0,4,4" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Carregar">
                        <Image Source="/recursos/icones/icons8-upload-20.png" Width="16" Height="16"/>
                    </Button>
                    <!-- Row 2 -->
                    <Button Command="{Binding RandomizeCommand}" Width="32" Height="26" Margin="0,0,4,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Aleatório">
                        <Image Source="/recursos/icones/icons8-random-20.png" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding PreviousCommand}" Width="32" Height="26" Margin="0,0,4,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Anterior">
                        <Image Source="/recursos/icones/icons8-back-20.png" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding PlayPauseCommand}" Width="32" Height="26" Margin="0,0,4,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Play/Pause">
                        <Image Source="{Binding PlayPauseIcon}" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding NextCommand}" Width="32" Height="26" Margin="0,0,4,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Próximo">
                        <Image Source="/recursos/icones/icons8-next-20.png" Width="16" Height="16"/>
                    </Button>
                </UniformGrid>

                <!-- Progress/Slider/Status Area -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <DockPanel LastChildFill="True" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="{Binding CurrentTime}" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text=" / " FontSize="11"/>
                            <TextBlock Text="{Binding Duration}" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <Slider Value="{Binding Progress, Mode=TwoWay}" Minimum="0" Maximum="100" Height="18" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Waveform Graphic -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource PanelBrush}" Height="40" Margin="0,8,0,0" CornerRadius="3" ClipToBounds="True" MouseLeftButtonDown="Waveform_MouseLeftButtonDown" Cursor="Hand">
                    <Grid>
                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Opacity="0.1" Background="Transparent" BorderThickness="0"/>
                        <Image Source="{Binding WaveformSource}" Stretch="Fill"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
